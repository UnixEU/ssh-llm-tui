# Copy to .env next to docker-compose.yml and adjust. Compose reads it
# automatically. Sizes accept k, M, G (powers of 1024) or plain bytes.

# tmpfs size of /uploads and /downloads. tmpfs lives in host RAM; only what
# is stored uses memory. Shared by all users, so size it for the number of
# users that upload at the same time.
UPLOADS_TMPFS_SIZE=256m
DOWNLOADS_TMPFS_SIZE=256m

# Per-user limits inside those mounts.
UPLOAD_MAX_TOTAL_BYTES=256M
DOWNLOAD_MAX_TOTAL_BYTES=256M
# Largest single uploaded file.
UPLOAD_MAX_BYTES=10M
